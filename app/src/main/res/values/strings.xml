<resources>
    <string name="app_name">五秒</string>

    <!-- Accessibility service -->
    <string name="accessibility_service_label">五秒 · 应用拦截</string>
    <string name="accessibility_service_description">五秒仅在你打开所选的沉浸式应用时弹出拦截页，引导一次 5 秒提肛锻炼并询问是否打开。本服务只读取应用包名以判断哪个应用进入前台，绝不读取或上传任何窗口内容。</string>

    <!-- Onboarding -->
    <string name="onboarding_title">五秒 · 每次打开前的 5 秒</string>
    <string name="onboarding_body">在打开抖音、小红书、B站等应用前，五秒会先弹窗，引导你做一次 5 秒提肛，并问你是否真的要打开——给无意识的刷手机加一道减速带。</string>
    <string name="onboarding_enable_accessibility">开启无障碍服务</string>
    <string name="onboarding_accessibility_enabled">无障碍服务已开启</string>
    <string name="onboarding_finish">进入应用</string>
    <string name="onboarding_restricted_hint">若无法开启，请在 系统 > 无障碍 > 已安装的应用 中「允许受限设置」（Android 13+）。</string>

    <!-- Blocking screen -->
    <string name="blocking_title">是否打开 %1$s？</string>
    <string-array name="blocking_exercise_hints">
        <item>收紧盆底肌，保持 5 秒</item>
        <item>深吸一口气，慢慢吐出来</item>
        <item>眨眼 10 次</item>
        <item>看一眼远处（6 米外的东西）</item>
        <item>耸肩到耳根，停 3 秒再放下</item>
        <item>闭上眼，问自己：现在真的要打开吗？</item>
        <item>攥紧拳头 3 秒，再完全张开手指</item>
    </string-array>
