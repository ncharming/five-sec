<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 兜底：拦截页主路径使用 Activity；SYSTEM_ALERT_WINDOW 仅作备用覆盖方式 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 列出已安装应用以供用户添加到拦截清单（侧载分发；Play 上架需另行评估） -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission"
        xmlns:tools="http://schemas.android.com/tools" />

    <!-- 经 adb 一次性授予后，可在应用内一键开启/自动恢复无障碍服务（signature 级，安装时不会自动授予） -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions"
        xmlns:tools="http://schemas.android.com/tools" />

    <!-- 待办到点提醒（specs/010）：全离线闹钟链路，零网络零内置音频 -->
    <!-- 13+ 通知运行时权限：到点全屏页经通知 full-screen intent 拉起，未授权则提醒不显示（页内横幅引导） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 12+ 精确闹钟：未开「闹钟和提醒」时自动降级非精确（仍响、可能漂移数分钟，页内横幅提示） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- full-screen intent 载体（normal 权限，14+ 由用户在设置放行「全屏显示」） -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 重启/时间变更后重排提醒闹钟（决策 5） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 提醒震动 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".FiveSecApp"
        android:allowBackup="true"
        android:hasFragileUserData="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FiveSec">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FiveSec">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".interception.AppBlockerAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 到点提醒全屏页（specs/010）：只经 full-screen intent 通知/通知点开进入；锁屏上显示、不进最近任务 -->
        <activity
            android:name=".reminder.TodoReminderActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.FiveSec" />

        <!-- 单一「下一响」闹钟落点（specs/010） -->
        <receiver
            android:name=".reminder.TodoReminderReceiver"
            android:exported="false" />

        <!-- 重启/覆盖更新/时间与时区变更后全量重排（系统保护广播，仅系统可发） -->
        <receiver
            android:name=".reminder.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
